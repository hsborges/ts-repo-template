{
  "name": "@hsborges/ts-template",
  "version": "2.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.21.0"
  },
  "scripts": {
    "check": "biome check",
    "check:fix": "biome check --fix",
    "prepare": "husky || true",
    "build": "tsc && tsc-alias",
    "dev": "tsx  -r \"dotenv-flow/config\" src/index.ts",
    "start": "node -r \"dotenv-flow/config\" dist/index.js",
    "test": "vitest run ./src --passWithNoTests",
    "test:coverage": "vitest run ./src --coverage",
    "verify": "run-s check test build",
    "release": "release-it"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@release-it/bumper": "^8.0.0",
    "@release-it/conventional-changelog": "^12.0.0",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "dotenv-flow": "^4.1.0",
    "husky": "^9.1.7",
    "npm-run-all": "^4.1.5",
    "release-it": "^21.0.2",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "resolutions": {
    "conventional-changelog-conventionalcommits": "10.3.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
